#!/usr/bin/env python3
"""Collect license material for the exact linked Go guest into a deterministic tar."""
import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile

ROOT = Path(__file__).resolve().parents[1]


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def digest(data):
    return hashlib.sha256(data).hexdigest()


def collect(binary, go):
    pinned = 'go' + (ROOT / '.go-version').read_text().strip()
    if output(go, 'env', 'GOVERSION') != pinned:
        raise ValueError('use the pinned Go toolchain')
    build = output(go, 'version', '-m', str(binary)).splitlines()
    if not build or not build[0].endswith(': ' + pinned):
        raise ValueError('guest must be built with the pinned Go toolchain')
    modules = []
    for line in build[1:]:
        fields = line.strip().split()
        if fields and fields[0] == '=>':
            raise ValueError('replaced Go modules require an explicit attribution audit')
        if fields and fields[0] == 'dep':
            if len(fields) != 4 or not fields[3].startswith('h1:'):
                raise ValueError('linked dependency lacks an immutable module checksum')
            modules.append(dict(zip(('path', 'version', 'sum'), fields[1:])))
    if not modules:
        raise ValueError('guest contains no auditable linked module metadata')
    files = {}

    def add(name, source):
        if source.is_symlink() or not source.is_file():
            raise ValueError('notice must be a regular file: ' + str(source))
        data = source.read_bytes()
        if not data or len(data) > 1 << 20:
            raise ValueError('notice must be nonempty and <=1MiB: ' + str(source))
        files[name] = data

    add('licenses/hypercall/LICENSE', ROOT / 'LICENSE')
    goroot = Path(output(go, 'env', 'GOROOT'))
    for name in ('LICENSE', 'AUTHORS', 'CONTRIBUTORS', 'PATENTS'):
        if (goroot / name).is_file():
            add('licenses/go/' + name, goroot / name)
    for module in sorted(modules, key=lambda m: m['path']):
        resolved = json.loads(output(go, 'mod', 'download', '-json', module['path'] + '@' + module['version']))
        if resolved.get('Error') or resolved.get('Sum') != module['sum']:
            raise ValueError('linked module checksum does not match resolved source: ' + module['path'])
        directory = Path(resolved['Dir'])
        prefix = 'licenses/modules/' + module['path'] + '@' + module['version'] + '/'
        found_license = False
        # Retain nested license/notice files too; transitive packages can carry
        # different attribution from the module's root license.
        for source in sorted(directory.rglob('*')):
            if not source.is_file():
                continue
            upper = source.name.upper()
            if any(upper == word or upper.startswith(word + '.') or upper.startswith(word + '-')
                   for word in ('LICENSE', 'LICENCE', 'COPYING', 'NOTICE', 'COPYRIGHT', 'AUTHORS', 'PATENTS')):
                add(prefix + source.relative_to(directory).as_posix(), source)
                found_license |= upper.startswith(('LICENSE', 'LICENCE', 'COPYING'))
        if not found_license:
            raise ValueError('linked module lacks license material: ' + module['path'])
    manifest = {'schema_version': 1, 'guest_sha256': digest(binary.read_bytes()),
                'go_version': pinned, 'modules': sorted(modules, key=lambda m: m['path']),
                'files': [{'path': name, 'sha256': digest(data)} for name, data in sorted(files.items())]}
    files['manifest.json'] = (json.dumps(manifest, indent=2, sort_keys=True) + '\n').encode()
    return files


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--guest-agent', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--go', default=os.environ.get('GO', 'go'))
    args = parser.parse_args()
    files = collect(args.guest_agent.resolve(strict=True), args.go)
    # Exclusive creation avoids silently replacing a previously reviewed bundle.
    with args.output.open('xb') as destination:
        with tarfile.open(fileobj=destination, mode='w', format=tarfile.USTAR_FORMAT) as archive:
            for name, data in sorted(files.items()):
                info = tarfile.TarInfo(name)
                info.size, info.mode, info.mtime = len(data), 0o644, 0
                archive.addfile(info, io.BytesIO(data))
    print(digest(args.output.read_bytes()))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError, KeyError, tarfile.TarError) as error:
        print('guest-notices: ' + str(error), file=sys.stderr)
        sys.exit(1)
